# Copy to .env or export in your shell before starting the web stack.

# Absolute path to the Blender executable (required if not on PATH)
# Windows example:
# DRONE_BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
# macOS example:
# DRONE_BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
# Linux example:
# DRONE_BLENDER_PATH=/usr/bin/blender

# Optional: object name appended from night_env1.blend (default: Water)
# DRONE_BGD_OBJECT=Water
